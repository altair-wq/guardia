# Guardia: Arbitrum One deploy config.
# Copy to contracts/.env (gitignored):   cp deploy.env.example .env
# Public addresses are prefilled. Fill the four SECRET/number lines ON THE LAPTOP ONLY.
# Never commit .env, never paste private keys into any chat.

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBISCAN_API_KEY=                 # SECRET: free key from etherscan.io (works for Arbiscan)

DEPLOYER_PRIVATE_KEY=             # SECRET: private key of 0xcD81A2cd737D9ed26506fCc287771c174a01bEfb
AGENT_ADDRESS=0x40912f9b8738C5714115B2A62ffA707c963577c2
AGENT_PRIVATE_KEY=                # SECRET: private key of the agent wallet above

# Limits in whole ARGt. Rule of thumb: per payment = 40% of the ARGt you will put in the vault,
# daily = 2.5 x per payment. Example with 10,000 ARGt: 4000 and 10000.
PER_PAYMENT_CAP_ARGT=
DAILY_CAP_ARGT=

SUPPLIER_BR_WALLET=0xD77BE95132Ad88b828bf3c2066d9509f54Fb0885   # Autopeças Sul Ltda (BRAt)
SUPPLIER_BR2_WALLET=0x54cF6eDB0128290629e48d37272705fAC221AA3b  # Têxtil Paraná Ltda (BRAt)
SUPPLIER_AR_WALLET=0xB88B9cEcEbD8B6cb8623A404695004534c0C901b   # Insumos del Litoral SRL (ARGt)

POLICY_VAULT=                     # filled automatically by deploy.sh after the deploy
BAD_RECIPIENT=0x000000000000000000000000000000000000dEaD
