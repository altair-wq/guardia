# Copy to contracts/.env (gitignored). Never commit real keys.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Etherscan V2 multichain key (works for Arbiscan)
ARBISCAN_API_KEY=

# Owner / deployer (the company)
DEPLOYER_PRIVATE_KEY=
# Agent hot wallet: address is set on the vault; key is used by ForceBadPayment.s.sol and the agent module
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Caps in whole ARGt (script multiplies by 1e18). Suggested: per-payment = 40% of balance, daily = 2.5x per-payment
PER_PAYMENT_CAP_ARGT=
DAILY_CAP_ARGT=

# Demo suppliers (wallets the team controls)
SUPPLIER_AR_WALLET=
SUPPLIER_BR_WALLET=
SUPPLIER_BR2_WALLET=

# ForceBadPayment: deployed vault and a non-allowlisted target
POLICY_VAULT=
BAD_RECIPIENT=0x000000000000000000000000000000000000dEaD
