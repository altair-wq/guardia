# Optional agent-only overrides (the root .env.example has the shared variables).
# Loaded after the root .env, so anything here wins. Never commit agent/.env.
LLM_MODEL=claude-opus-5-5

# Port: PORT wins, then AGENT_PORT, then 8787.
# PORT=8787
# Required for POST /invoices and POST /demo/reset coming through the tunnel (header x-guardia-key).
# Unset = only requests from this machine can POST.
GUARDIA_API_KEY=
# CORS origins, comma-separated. Unset = http://localhost:3000 + any https://*.vercel.app
# ALLOWED_ORIGINS=https://guardia.vercel.app,http://localhost:3000
