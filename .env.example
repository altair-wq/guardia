# Copy to .env and fill in. Never commit .env.

# --- chain ---
ARBITRUM_RPC_URL=
DEPLOYER_PRIVATE_KEY=        # owner of the PolicyVault (contracts module)
AGENT_PRIVATE_KEY=           # the only address allowed to call pay() (agent module)
ARBISCAN_API_KEY=            # contract verification

# --- agent ---
LLM_API_KEY=
FIRECRAWL_API_KEY=
MOCK_CHAIN=true              # true = fake vault client, no contract needed
AGENT_PORT=8787

# --- web ---
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
NEXT_PUBLIC_USE_FIXTURES=true  # true = read shared/fixtures/decisions.json, no agent needed

# --- avalanche variant (only if we enter the Blockchain track) ---
AVALANCHE_RPC_URL=
SNOWTRACE_API_KEY=
